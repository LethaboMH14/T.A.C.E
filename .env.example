# Copy this file to .env (git-ignored) and paste your key after the = sign.
# Never commit .env and never paste the key into a chat.
#
# Meta Model API (formerly Llama API): https://dev.meta.ai/docs/
MODEL_API_KEY=
# Optional overrides (defaults shown)
# MODEL_BASE_URL=https://api.meta.ai/v1
# MODEL_NAME=muse-spark-1.3
# An older Llama API key also works if you set LLAMA_API_KEY and its base URL in MODEL_BASE_URL.

# Coordinator sign-in: the Studio asks for an account when the LMS is configured. Set STUDIO_LOGIN=off to turn that off (local only).
# STUDIO_LOGIN=
# "Check your portal" notifications through Brevo (see docs/NOTIFICATIONS.md). Leave unset and nothing is sent.
# BREVO_API_KEY=
# NOTIFY_FROM_EMAIL=
# NOTIFY_FROM_NAME=Learning Portal
# NOTIFY_SMS_SENDER=
# PORTAL_URL=
