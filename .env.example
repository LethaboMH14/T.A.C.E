# Copy this file to .env (git-ignored) and paste your key after the = sign.
# Never commit .env and never paste the key into a chat.
#
# Meta Model API (formerly Llama API): https://dev.meta.ai/docs/
MODEL_API_KEY=
# Optional overrides (defaults shown)
# MODEL_BASE_URL=https://api.meta.ai/v1
# MODEL_NAME=muse-spark-1.3
# An older Llama API key also works if you set LLAMA_API_KEY and its base URL in MODEL_BASE_URL.
