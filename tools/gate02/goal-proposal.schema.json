{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LethaboMH14/T.A.C.E/blob/main/tools/gate02/goal-proposal.schema.json",
  "title": "T.A.C.E G02.02 GoalContractProposal v0.2 — UNTRUSTED MODEL PROPOSAL",
  "description": "Domain-neutral candidate outcomes only; no approval, execution, source authorization or verified result. Cross-field invariants require the companion deterministic validator.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "g02-goal-proposal-v0.2"
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]+$"
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CREATE",
              "ANALYZE",
              "TRANSFORM",
              "COORDINATE",
              "COMMUNICATE",
              "UNKNOWN"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        }
      },
      "required": [
        "summary",
        "modes"
      ]
    },
    "relationToPrior": {
      "type": "string",
      "enum": [
        "NEW_GOAL",
        "REFINEMENT",
        "CORRECTION",
        "UNKNOWN"
      ]
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$",
            "minLength": 1,
            "maxLength": 32
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]+$"
          },
          "formatHint": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]+$"
          }
        },
        "required": [
          "id",
          "description",
          "formatHint"
        ]
      },
      "minItems": 1,
      "maxItems": 8
    },
    "subgoals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$",
            "minLength": 1,
            "maxLength": 32
          },
          "outcome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]+$"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$",
              "minLength": 1,
              "maxLength": 32
            },
            "minItems": 0,
            "maxItems": 11,
            "uniqueItems": true
          },
          "deliverableIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$",
              "minLength": 1,
              "maxLength": 32
            },
            "minItems": 0,
            "maxItems": 8,
            "uniqueItems": true
          },
          "sourceSlots": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            },
            "minItems": 0,
            "maxItems": 24,
            "uniqueItems": true
          },
          "capabilityKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "READ_SOURCE",
                "WRITE_ARTIFACT",
                "SEARCH_PUBLIC",
                "CONNECTOR_READ",
                "CONNECTOR_WRITE",
                "MESSAGE_DRAFT",
                "MESSAGE_SEND",
                "SCHEDULING",
                "UNKNOWN"
              ]
            },
            "minItems": 0,
            "maxItems": 12,
            "uniqueItems": true
          },
          "effectKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "READ_ONLY",
                "LOCAL_ARTIFACT",
                "SHARED_WRITE",
                "EXTERNAL_SEND",
                "DESTRUCTIVE",
                "UNKNOWN"
              ]
            },
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "outcome",
          "dependsOn",
          "deliverableIds",
          "sourceSlots",
          "capabilityKinds",
          "effectKinds"
        ]
      },
      "minItems": 1,
      "maxItems": 12
    },
    "sourceSlots": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 23
      },
      "minItems": 0,
      "maxItems": 24,
      "uniqueItems": true
    },
    "capabilityNeeds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "READ_SOURCE",
              "WRITE_ARTIFACT",
              "SEARCH_PUBLIC",
              "CONNECTOR_READ",
              "CONNECTOR_WRITE",
              "MESSAGE_DRAFT",
              "MESSAGE_SEND",
              "SCHEDULING",
              "UNKNOWN"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]+$"
          }
        },
        "required": [
          "kind",
          "reason"
        ]
      },
      "minItems": 0,
      "maxItems": 12
    },
    "effectClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "READ_ONLY",
              "LOCAL_ARTIFACT",
              "SHARED_WRITE",
              "EXTERNAL_SEND",
              "DESTRUCTIVE",
              "UNKNOWN"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]+$"
          }
        },
        "required": [
          "kind",
          "description"
        ]
      },
      "minItems": 1,
      "maxItems": 8
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$",
            "minLength": 1,
            "maxLength": 32
          },
          "deliverableId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$",
            "minLength": 1,
            "maxLength": 32
          },
          "check": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]+$"
          },
          "method": {
            "type": "string",
            "enum": [
              "ARTIFACT_REOPEN",
              "SCHEMA_VALIDATION",
              "SOURCE_CROSSCHECK",
              "SCHEDULE_CONFLICT_CHECK",
              "HUMAN_REVIEW",
              "OTHER"
            ]
          },
          "evidenceExpectation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]+$"
          }
        },
        "required": [
          "id",
          "deliverableId",
          "check",
          "method",
          "evidenceExpectation"
        ]
      },
      "minItems": 1,
      "maxItems": 16
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "MISSING_INPUT",
              "AMBIGUOUS_REFERENCE",
              "UNRESOLVED_TIME",
              "MISSING_RECIPIENT",
              "UNSUPPORTED_FORMAT",
              "UNKNOWN_EFFECT",
              "OTHER"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]+$"
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "question",
          "blocking"
        ]
      },
      "minItems": 0,
      "maxItems": 12
    }
  },
  "required": [
    "schemaVersion",
    "intent",
    "relationToPrior",
    "deliverables",
    "subgoals",
    "sourceSlots",
    "capabilityNeeds",
    "effectClaims",
    "acceptanceCriteria",
    "uncertainties"
  ],
  "$comment": "The runtime validator additionally checks DAG acyclicity, reference coverage, effect/capability consistency, trusted-intake source-slot bounds, total UTF-8 bytes and revision semantics. JSON Schema alone is insufficient."
}
